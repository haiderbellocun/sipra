# ───────────────────────────────────────────────────────────────────────────
# SIPRA PRÁCTICAS — plantilla de variables de entorno
# NUNCA versionar el archivo .env real. En GCP las variables sensibles se
# inyectan desde Secret Manager (ver infra/gcp/README.md).
# ───────────────────────────────────────────────────────────────────────────

# ── Aplicación ─────────────────────────────────────────────────────────────
NODE_ENV=development
# dev | qa | pre | prod  (uno de los cuatro ambientes GCP)
SIPRA_AMBIENTE=dev
PORT=3000
API_PREFIJO=api
API_VERSION=1
CORS_ORIGENES=http://localhost:4200

# ── Base de datos (Cloud SQL for PostgreSQL en GCP) ────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=sipra
DB_PASSWORD=sipra_local_dev
DB_NAME=sipra_dev
DB_SSL=false
# En Cloud Run usar el socket del conector: /cloudsql/PROYECTO:REGION:INSTANCIA
DB_SOCKET_PATH=

# ── Redis (Memorystore en GCP) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SEGUNDOS=300

# ── Autenticación ──────────────────────────────────────────────────────────
# abierto  → selector de perfil sin contraseña. SOLO desarrollo local: exige además
#            SIPRA_AMBIENTE=dev y AUTH_ABIERTO_CONFIRMADO=true; en otro caso no arranca
# oidc     → Google Workspace OIDC (obligatorio en qa, pre y prod)
# AUTH_MODO y SIPRA_AMBIENTE no tienen valor por defecto: deben declararse siempre.
AUTH_MODO=abierto
AUTH_ABIERTO_CONFIRMADO=true
JWT_SECRETO=cambiar-en-cada-ambiente-secreto-de-al-menos-32-caracteres
JWT_EXPIRACION=8h
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Pantalla del FRONTEND que recibe el retorno de Google (code + state); debe estar
# registrada tal cual en el cliente OAuth. El frontend la reenvía por POST a la API.
OIDC_REDIRECT_URI=http://localhost:4200/ingreso/callback
OIDC_DOMINIOS_PERMITIDOS=cun.edu.co,estudiante.cun.edu.co

# ── Almacenamiento de documentos (Cloud Storage) ───────────────────────────
# local | gcs
STORAGE_DRIVER=local
STORAGE_RUTA_LOCAL=./.almacen
GCS_BUCKET=sipra-dev-documentos
GCS_ENLACE_FIRMADO_MINUTOS=10
DOC_TAMANO_MAXIMO_MB=10

# ── Lectura documental asistida (capa 2 del pipeline) ──────────────────────
# simulado | openai | anthropic
#   simulado  → sin llave; lee la capa de texto de los PDF (ambiente de pruebas).
#   openai    → Responses API con salida JSON estricta; exige OPENAI_API_KEY.
IA_DRIVER=simulado
OPENAI_API_KEY=
# Modelo y esfuerzo de razonamiento. gpt-6-luna es el más económico del
# catálogo vigente; alternativas: gpt-5.6-luna, gpt-5.4-mini, gpt-4.1-mini.
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=low
OPENAI_URL_BASE=https://api.openai.com/v1
OPENAI_TIEMPO_MAXIMO_MS=120000
OPENAI_MAX_TOKENS_SALIDA=4000
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5
# Conservada por compatibilidad: el tope vigente es el parámetro ia.tope_diario_usd (Parámetros).
IA_TOPE_DIARIO_USD=50

# ── Integración SINU (solo lectura) ────────────────────────────────────────
SINU_DRIVER=simulado
SINU_BASE_URL=
SINU_API_KEY=
SINU_VENTANA_SINCRONIZACION_CRON=0 3 * * *

# ── Notificaciones ─────────────────────────────────────────────────────────
# CORREO_DRIVER se define más abajo, en «Google Workspace».
CORREO_REMITENTE=practicas@cun.edu.co

# ── Observabilidad ─────────────────────────────────────────────────────────
# GET /api/v1/metrics exige Authorization: Bearer <METRICAS_TOKEN> (≥ 32 caracteres).
# Sin token el endpoint responde 404; fuera de dev es obligatorio (o METRICAS_HABILITADAS=false).
# Genérelo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICAS_HABILITADAS=true
METRICAS_TOKEN=
METRICAS_RUTA=/metrics
LOG_NIVEL=debug

# ── Cola de trabajo ────────────────────────────────────────────────────────
# en_proceso  → cola en memoria, drenado diferido (SOLO dev y qa)
# en_linea    → atiende el trabajo antes de responder. Necesario donde el
#               proceso se congela al terminar la petición (ambiente puente
#               sin servidor), donde un drenado diferido no llegaría a correr
# cloud_tasks → Cloud Tasks (obligatorio en pre y prod: el pico de cierre de
#               periodo son 40.000 a 50.000 documentos en dos semanas)
COLA_DRIVER=en_proceso
GCP_PROYECTO=
GCP_REGION=us-central1
GCP_CUENTA_SERVICIO=
WORKER_URL=

# ── Reportes al Servicio Público de Empleo ─────────────────────────────────
# NIT del prestador autorizado (la CUN), sin dígito de verificación.
SPE_NIT_PRESTADOR=000000000
# Poner en true SOLO cuando la Dirección de Extensión confirme la estructura
# del archivo contra el anexo técnico vigente. Mientras sea false, los archivos
# se generan marcados como borrador y no se marcan las vacantes como reportadas.
SPE_ANEXO_CONFIRMADO=false

# ── Google Workspace (correo institucional) ────────────────────────────────
# consola   → los avisos se escriben en el registro (dev y qa)
# workspace → API de Gmail con cuenta de servicio y delegación en todo el dominio
CORREO_DRIVER=consola
# Cuenta de servicio autorizada para el alcance gmail.send.
WORKSPACE_CUENTA_SERVICIO=
# Clave privada de la cuenta de servicio. NUNCA en el repositorio:
# se inyecta desde Secret Manager.
WORKSPACE_CLAVE_PRIVADA=
